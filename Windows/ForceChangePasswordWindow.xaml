<Window x:Class="КР_Ханников.Windows.ForceChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Требуется смена пароля"
        Height="520"
        Width="480"
        MinHeight="480"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource Brush.Surface}"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="🔐" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="1" Text="Смена пароля обязательна"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2"
                       Text="Для вашего аккаунта установлен временный пароль. Пожалуйста, задайте новый пароль перед входом."
                       FontSize="13"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,32"/>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="Новый пароль"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="NewPasswordBox"
                             Height="44"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource Brush.Border}"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             FontSize="14"
                             PasswordChanged="PasswordBox_Changed">
                    <PasswordBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </PasswordBox.Resources>
                </PasswordBox>
            </StackPanel>

            <!-- Индикатор силы пароля -->
            <Grid Grid.Row="4" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StrengthBar1" Grid.Column="0" Height="4" CornerRadius="2"
                        Background="{DynamicResource Brush.Border}" Margin="0,0,4,0"/>
                <Border x:Name="StrengthBar2" Grid.Column="1" Height="4" CornerRadius="2"
                        Background="{DynamicResource Brush.Border}" Margin="0,0,4,0"/>
                <Border x:Name="StrengthBar3" Grid.Column="2" Height="4" CornerRadius="2"
                        Background="{DynamicResource Brush.Border}"/>
            </Grid>

            <TextBlock x:Name="StrengthLabel" Grid.Row="5"
                       FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                       HorizontalAlignment="Right" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="6" Margin="0,0,0,16">
                <TextBlock Text="Повторите пароль"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="44"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource Brush.Border}"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             FontSize="14">
                    <PasswordBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </PasswordBox.Resources>
                </PasswordBox>
            </StackPanel>

            <!-- Блок ошибки -->
            <Border x:Name="ErrorBorder" Grid.Row="7" CornerRadius="7"
                    Background="#FEF2F2" BorderThickness="1" BorderBrush="#FECACA"
                    Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <Button Grid.Row="8" x:Name="SaveButton"
                    Content="Сохранить новый пароль"
                    Height="44"
                    Background="{DynamicResource Brush.Primary}"
                    Foreground="{DynamicResource Brush.TextOnPrimary}"
                    BorderThickness="0"
                    FontSize="14" FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="Save_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
