<UserControl x:Class="КР_Ханников.Windows.MlMetricsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="{DynamicResource Brush.Background}">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" Padding="24,20"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Метрики ML-моделей" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Text="Качество моделей классификации тикетов по категории и приоритету"
                               FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Переобучить и оценить" Height="38" Padding="16,0"
                        FontWeight="SemiBold" FontSize="13" Cursor="Hand"
                        Background="{DynamicResource Brush.Primary}" Foreground="{DynamicResource Brush.TextOnPrimary}"
                        BorderThickness="0" Click="Retrain_Click" x:Name="RetrainBtn">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="📂 Модель категорий" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Micro-accuracy" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="CatMicroText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Macro-accuracy" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="CatMacroText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Log-loss" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="CatLossText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Размер выборки" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="CatSampleText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                    <TextBlock x:Name="CatTrainedText" Text="" FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="⚡ Модель приоритетов" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Micro-accuracy" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="PrioMicroText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Macro-accuracy" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="PrioMacroText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Log-loss" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="PrioLossText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Размер выборки" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" x:Name="PrioSampleText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                    <TextBlock x:Name="PrioTrainedText" Text="" FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource MetricCard}" Margin="24,8,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📊 История обучения" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Модель" Binding="{Binding ModelType}" Width="120"/>
                        <DataGridTextColumn Header="Дата обучения" Binding="{Binding TrainedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="160"/>
                        <DataGridTextColumn Header="Micro" Binding="{Binding MicroAccuracyDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Macro" Binding="{Binding MacroAccuracyDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Log-loss" Binding="{Binding LogLossDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Выборка" Binding="{Binding SampleCount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" x:Name="NoMetricsText" Text="Метрики ещё не собраны. Запустите переобучение модели."
                           FontSize="13" Foreground="{DynamicResource Brush.TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
