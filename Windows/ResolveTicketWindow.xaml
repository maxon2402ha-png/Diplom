<Window x:Class="КР_Ханников.Windows.ResolveTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Решение заявки"
        Height="460" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.Background}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" Padding="24,18"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Решение заявки" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock Text="Опишите решение для клиента. После сохранения заявка перейдёт в статус «Resolved» и будет ждать подтверждения клиента."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,18">
            <TextBlock Text="Текст решения" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6"/>
            <TextBox x:Name="ResolutionBox"
                     Height="170"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="10"
                     FontSize="14"
                     Background="{DynamicResource Brush.Surface}"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     BorderBrush="{DynamicResource Brush.Border}"
                     BorderThickness="1"/>
            <TextBlock x:Name="ErrorText" Text="Укажите текст решения." Foreground="#DC2626"
                       FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>

            <TextBlock Text="Статья базы знаний (необязательно)" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,14,0,6"/>
            <ComboBox x:Name="ArticleCombo" Height="34"
                      DisplayMemberPath="Title"
                      Background="{DynamicResource Brush.Surface}"
                      Foreground="{DynamicResource Brush.TextPrimary}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" Padding="20,14"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="Cancel_Click" IsCancel="True"
                        Width="120" Height="38" Margin="0,0,12,0"
                        Background="Transparent" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" Foreground="{DynamicResource Brush.TextPrimary}" Cursor="Hand"/>
                <Button x:Name="SaveButton" Content="Сохранить решение" Click="Save_Click" IsDefault="True"
                        Width="180" Height="38"
                        Background="{DynamicResource Brush.Primary}" Foreground="{DynamicResource Brush.TextOnPrimary}"
                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
