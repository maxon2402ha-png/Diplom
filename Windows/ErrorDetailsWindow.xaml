<Window x:Class="КР_Ханников.Windows.ErrorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибка приложения"
        Height="420"
        Width="600"
        MinHeight="320"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource Brush.Surface}"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Padding="20,16" MouseLeftButtonDown="TitleBar_MouseDown"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="20" Foreground="#EF4444" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Произошла ошибка" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Brush.TextSecondary}" FontSize="14"
                            Cursor="Hand" Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Тело -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SummaryText" Grid.Row="0"
                           FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}"
                        CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="DetailsBox"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 Background="Transparent" BorderThickness="0"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 Padding="12"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Кнопки -->
            <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Brush.Border}">
                <Grid>
                    <TextBlock x:Name="LogPathText" FontSize="11"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Left" MaxWidth="300"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CopyButton" Content="Копировать детали"
                                Width="160" Height="36" Margin="0,0,8,0"
                                Background="{DynamicResource Brush.Primary}"
                                Foreground="{DynamicResource Brush.TextOnPrimary}"
                                BorderThickness="0" Cursor="Hand"
                                Click="Copy_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryDark}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Закрыть" Width="100" Height="36"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                Cursor="Hand" Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
