<Window x:Class="КР_Ханников.Windows.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сброс пароля"
        Height="460" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="Новый пароль" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Brush.TextSecondary}" Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="32,20">

                <TextBlock Text="Введите токен из письма и придумайте новый пароль."
                           FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBlock Text="Токен" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6"/>
                <TextBox x:Name="TokenBox" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                         BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                         Background="{DynamicResource Brush.Surface}"
                         Foreground="{DynamicResource Brush.TextPrimary}"
                         FontFamily="Consolas" FontSize="15"
                         CharacterCasing="Upper" Margin="0,0,0,14">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Новый пароль" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="NewPasswordBox" Height="44" Padding="12,0"
                             VerticalContentAlignment="Center" BorderThickness="1"
                             BorderBrush="{DynamicResource Brush.Border}"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             FontSize="14" Margin="0,0,0,6"
                             PasswordChanged="Password_Changed">
                    <PasswordBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- Strength bars -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Bar1" Grid.Column="0" Height="4" CornerRadius="2"
                            Background="{DynamicResource Brush.Border}" Margin="0,0,4,0"/>
                    <Border x:Name="Bar2" Grid.Column="1" Height="4" CornerRadius="2"
                            Background="{DynamicResource Brush.Border}" Margin="0,0,4,0"/>
                    <Border x:Name="Bar3" Grid.Column="2" Height="4" CornerRadius="2"
                            Background="{DynamicResource Brush.Border}"/>
                </Grid>
                <TextBlock x:Name="StrengthLabel" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,10"/>

                <TextBlock Text="Повторите пароль" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="ConfirmBox" Height="44" Padding="12,0"
                             VerticalContentAlignment="Center" BorderThickness="1"
                             BorderBrush="{DynamicResource Brush.Border}"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             FontSize="14" Margin="0,0,0,14">
                    <PasswordBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <Border x:Name="ErrorBorder" CornerRadius="7" Background="#FEF2F2"
                        BorderThickness="1" BorderBrush="#FECACA" Padding="12,8"
                        Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <Button x:Name="SaveBtn" Content="Сохранить новый пароль" Height="44"
                        Background="{DynamicResource Brush.Primary}"
                        Foreground="{DynamicResource Brush.TextOnPrimary}"
                        BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                        Cursor="Hand" Click="Save_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.PrimaryDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
