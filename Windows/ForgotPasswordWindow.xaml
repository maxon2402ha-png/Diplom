<Window x:Class="КР_Ханников.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля"
        Height="400" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="Восстановление пароля" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Brush.TextSecondary}" Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Содержимое -->
            <StackPanel Grid.Row="1" Margin="32,28" VerticalAlignment="Center">

                <TextBlock Text="📧" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Введите email, указанный при регистрации. Мы отправим вам токен для сброса пароля."
                           FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                         BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                         Background="{DynamicResource Brush.Surface}"
                         Foreground="{DynamicResource Brush.TextPrimary}" FontSize="14" Margin="0,0,0,16">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Ошибка -->
                <Border x:Name="ErrorBorder" CornerRadius="7" Background="#FEF2F2"
                        BorderThickness="1" BorderBrush="#FECACA" Padding="12,8"
                        Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Успех -->
                <Border x:Name="SuccessBorder" CornerRadius="7" Background="#F0FDF4"
                        BorderThickness="1" BorderBrush="#86EFAC" Padding="12,8"
                        Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="SuccessText" Foreground="#16A34A" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <Button x:Name="SendButton" Content="Отправить токен" Height="44"
                        Background="{DynamicResource Brush.Primary}"
                        Foreground="{DynamicResource Brush.TextOnPrimary}"
                        BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                        Cursor="Hand" Click="Send_Click" Margin="0,0,0,12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.PrimaryDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="У меня есть токен — ввести пароль" Height="38"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Brush.Primary}" FontSize="13"
                        Cursor="Hand" Click="EnterToken_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
