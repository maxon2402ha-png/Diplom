<UserControl x:Class="КР_Ханников.Windows.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
            <Border Width="80" Height="80" CornerRadius="40"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock x:Name="IconText" Text="📭" FontSize="38"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleText" Text="Здесь пока пусто"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock x:Name="MessageText" Text=""
                       FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>
            <Button x:Name="ActionButton" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Primary}"
                    Foreground="{DynamicResource Brush.TextOnPrimary}"
                    FontWeight="SemiBold" FontSize="13"
                    Height="36" Padding="20,0" BorderThickness="0"
                    Cursor="Hand" HorizontalAlignment="Center"
                    Click="ActionButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
