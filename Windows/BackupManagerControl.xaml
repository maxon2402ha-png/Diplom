<UserControl x:Class="КР_Ханников.Windows.BackupManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="{DynamicResource Brush.Background}">

    <UserControl.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" Padding="24,20"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Резервное копирование БД" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Text="Создание и восстановление резервных копий PostgreSQL"
                               FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="💾 Создать резервную копию"
                        Style="{StaticResource PrimaryBtn}" Click="CreateBackup_Click"
                        x:Name="CreateBtn"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FEF9C3" BorderBrush="#FACC15" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="24,16,24,0">
            <StackPanel>
                <TextBlock Text="ℹ️ Информация" FontWeight="SemiBold" FontSize="12" Foreground="#854D0E" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#713F12">
                    <Run Text="Резервные копии создаются автоматически каждую ночь в 03:00."/>
                    <LineBreak/>
                    <Run Text="Хранятся последние 14 копий в:"/>
                    <Run x:Name="BackupsPathText" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock x:Name="StatusText" Text="" FontSize="12" Margin="0,8,0,0"
                           Foreground="#1F2937" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" Margin="24,16,24,24"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="История резервных копий" FontWeight="SemiBold"
                                   FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔄 Обновить" Style="{StaticResource SecondaryBtn}" Click="Refresh_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="NoBackupsText" Text="Резервных копий пока нет."
                                   FontSize="13" Foreground="{DynamicResource Brush.TextMuted}"
                                   Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,24"/>

                        <ItemsControl x:Name="BackupsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource Brush.SurfaceAlt}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🗄" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="13"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                               FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                    <TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Открыть папку" Style="{StaticResource SecondaryBtn}"
                                                    Tag="{Binding FullPath}" Click="OpenFolder_Click" Margin="4,0"/>
                                            <Button Grid.Column="3" Content="Восстановить" Style="{StaticResource SecondaryBtn}"
                                                    Tag="{Binding FullPath}" Click="Restore_Click" Margin="4,0"/>
                                            <Button Grid.Column="4" Content="Удалить" Style="{StaticResource DangerBtn}"
                                                    Tag="{Binding FullPath}" Click="Delete_Click" Margin="4,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
