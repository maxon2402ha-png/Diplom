<UserControl x:Class="КР_Ханников.Windows.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             FontFamily="Segoe UI"
             Background="{DynamicResource Brush.Background}">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" Padding="24,20"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Расширенные отчёты" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock Text="Динамика, распределение и нагрузка операторов с возможностью экспорта"
                           FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Фильтры и экспорт -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="С" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FromDatePicker" Height="32" Width="140"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="По" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="ToDatePicker" Height="32" Width="140"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Статус" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="StatusFilter" Height="32" Width="130"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="Приоритет" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PriorityFilter" Height="32" Width="130"/>
                </StackPanel>

                <Button Grid.Column="5" Content="Применить" Style="{StaticResource PrimaryBtn}"
                        Click="Apply_Click" Margin="0,18,8,0" VerticalAlignment="Bottom"/>
                <Button Grid.Column="6" Content="📊 Excel" Style="{StaticResource SecondaryBtn}"
                        Click="ExportExcel_Click" Margin="0,18,8,0" VerticalAlignment="Bottom"/>
                <Button Grid.Column="7" Content="📄 PDF" Style="{StaticResource SecondaryBtn}"
                        Click="ExportPdf_Click" Margin="0,18,0,0" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="24,8,24,24">
            <StackPanel>

                <!-- Сводка -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Всего тикетов" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock x:Name="TotalText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Закрыто" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock x:Name="ClosedText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="В работе" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock x:Name="ActiveText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#3B82F6" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Просрочено" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock x:Name="OverdueText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Динамика создания / закрытия -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Динамика создания и закрытия тикетов" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                        <lvc:CartesianChart x:Name="DynamicsChart" Height="260">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Дата" Labels="{Binding DynamicsLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis MinValue="0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- Распределение по категориям -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Распределение по категориям" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                        <lvc:CartesianChart x:Name="CategoryChart" Height="240">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Категория" Labels="{Binding CategoryLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis MinValue="0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- Нарушения SLA по операторам -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Нарушения SLA по операторам" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                        <lvc:CartesianChart x:Name="SlaChart" Height="240">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Оператор" Labels="{Binding OperatorLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Тикетов" MinValue="0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- Тепловая карта по дням недели и часам -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Активность по дням недели" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                        <lvc:CartesianChart x:Name="HeatmapChart" Height="220">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="День недели" Labels="{Binding DayLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Тикетов" MinValue="0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
